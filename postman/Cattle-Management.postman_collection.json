{
  "info": {
    "name": "Cattle Management API",
    "description": "Run in order against the Development environment. The collection verifies the domain endpoints and RFC 7807 error responses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create herd",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runId', String(Date.now()));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Herd created', function () {",
              "  pm.response.to.have.status(201);",
              "  const herd = pm.response.json();",
              "  pm.expect(herd.id).to.be.a('string');",
              "  pm.expect(herd.name).to.eql('North Pasture ' + pm.collectionVariables.get('runId'));",
              "  pm.collectionVariables.set('herdId', herd.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"North Pasture {{runId}}\",\"description\":\"Breeding herd\"}"
        },
        "url": "{{baseUrl}}/api/herds"
      }
    },
    {
      "name": "Register animal",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Animal created and linked to herd', function () {",
              "  pm.response.to.have.status(201);",
              "  const animal = pm.response.json();",
              "  pm.expect(animal.earTag).to.eql('C-' + pm.collectionVariables.get('runId'));",
              "  pm.expect(animal.herdId).to.eql(pm.collectionVariables.get('herdId'));",
              "  pm.expect(animal.healthStatus).to.eql(0);",
              "  pm.collectionVariables.set('animalId', animal.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"earTag\":\"C-{{runId}}\",\"breed\":\"Brahman\",\"herdId\":\"{{herdId}}\"}"
        },
        "url": "{{baseUrl}}/api/animals"
      }
    },
    {
      "name": "Get registered animal",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Registered animal is available', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('animalId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/animals/{{animalId}}"
      }
    },
    {
      "name": "Update animal health status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Animal health status updated', function () {",
              "  pm.response.to.have.status(200);",
              "  const animal = pm.response.json();",
              "  pm.expect(animal.id).to.eql(pm.collectionVariables.get('animalId'));",
              "  pm.expect(animal.healthStatus).to.eql(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"status\":1}"
        },
        "url": "{{baseUrl}}/api/animals/{{animalId}}/health-status"
      }
    },
    {
      "name": "Missing animal returns 404 Problem Details",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 uses RFC 7807', function () {",
              "  pm.response.to.have.status(404);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "  const problem = pm.response.json();",
              "  pm.expect(problem).to.include({ type: 'about:blank', title: 'Not Found', status: 404 });",
              "  pm.expect(problem.detail).to.be.a('string').and.not.empty;",
              "  pm.expect(problem.instance).to.eql('/api/animals/00000000-0000-0000-0000-000000000000');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/animals/00000000-0000-0000-0000-000000000000"
      }
    },
    {
      "name": "Duplicate animal returns 400 Problem Details",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 uses RFC 7807', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "  const problem = pm.response.json();",
              "  pm.expect(problem).to.include({ type: 'about:blank', title: 'Bad Request', status: 400 });",
              "  pm.expect(problem.detail).to.be.a('string').and.not.empty;",
              "  pm.expect(problem.instance).to.eql('/api/animals');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"earTag\":\"c-{{runId}}\",\"breed\":\"Holstein\",\"herdId\":\"{{herdId}}\"}"
        },
        "url": "{{baseUrl}}/api/animals"
      }
    },
    {
      "name": "Unexpected exception returns safe 500 Problem Details",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('500 hides internal details and stack trace', function () {",
              "  pm.response.to.have.status(500);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "  const problem = pm.response.json();",
              "  pm.expect(problem).to.include({ type: 'about:blank', title: 'Internal Server Error', status: 500 });",
              "  pm.expect(problem.detail).to.eql('An unexpected error occurred.');",
              "  pm.expect(problem.instance).to.eql('/api/demo/errors/unexpected');",
              "  pm.expect(pm.response.text()).not.to.include('Simulated internal detail');",
              "  pm.expect(pm.response.text()).not.to.include('stackTrace');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/demo/errors/unexpected"
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:18080" },
    { "key": "runId", "value": "" },
    { "key": "herdId", "value": "" },
    { "key": "animalId", "value": "" }
  ]
}
