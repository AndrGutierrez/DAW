{
  "info": {
    "name": "Cattle Management API",
    "description": "Run in order against the Development environment. Covers authentication/permissions (RBAC) and the animal read endpoints with RFC 7807 errors. Set baseUrl and the admin credentials to match the seeded data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication & Permissions",
      "item": [
        {
          "name": "Login as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin logs in and receives a token', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.user.username).to.eql(pm.collectionVariables.get('adminUsername'));",
                  "  pm.expect(body.user.isSuperuser).to.eql(true);",
                  "  ['accessToken', 'refreshToken'].forEach(function (key) {",
                  "    pm.collectionVariables.set(key, body[key]);",
                  "    if (pm.environment.name) { pm.environment.set(key, body[key]); }",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{adminUsername}}\",\"password\":\"{{adminPassword}}\"}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh returns new tokens', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refreshToken).to.not.eql(pm.collectionVariables.get('refreshToken'));",
                  "  ['accessToken', 'refreshToken'].forEach(function (key) {",
                  "    pm.collectionVariables.set(key, body[key]);",
                  "    if (pm.environment.name) { pm.environment.set(key, body[key]); }",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"refreshToken\":\"{{refreshToken}}\"}"
            },
            "url": "{{baseUrl}}/api/auth/refresh"
          }
        },
        {
          "name": "Get current user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authenticated user exposes roles and permissions', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const user = pm.response.json();",
                  "  pm.expect(user.username).to.eql(pm.collectionVariables.get('adminUsername'));",
                  "  pm.expect(user.permissions).to.be.an('array').and.not.empty;",
                  "  pm.expect(user.permissions).to.include('animals.list');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "List roles with permission",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Superuser lists roles', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const roles = pm.response.json();",
                  "  pm.expect(roles).to.be.an('array');",
                  "  pm.expect(roles.map(r => r.name)).to.include('Administrador');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/roles"
          }
        },
        {
          "name": "List permissions with permission",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Superuser lists permissions with guard', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const permissions = pm.response.json();",
                  "  pm.expect(permissions).to.be.an('array').and.not.empty;",
                  "  pm.expect(permissions[0].guardName).to.eql('web');",
                  "  pm.expect(permissions.map(p => p.name)).to.include('animals.get');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/permissions"
          }
        },
        {
          "name": "Protected endpoint without token returns 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Anonymous request is rejected', function () {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/api/animals"
          }
        },
        {
          "name": "Register user without permissions",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', String(Date.now()));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('New user is registered and logs in', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.user.roles).to.be.an('array').and.be.empty;",
                  "  pm.collectionVariables.set('newUserToken', body.accessToken);",
                  "  if (pm.environment.name) { pm.environment.set('newUserToken', body.accessToken); }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"operario{{runId}}\",\"email\":\"operario{{runId}}@daw.local\",\"password\":\"User123!Test\",\"fullName\":\"Operario de campo\"}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "User without permission is forbidden",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing permission returns 403', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{newUserToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/animals"
          }
        }
      ]
    },
    {
      "name": "List animals",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Authorized user lists animals with relevant info', function () {",
              "  pm.response.to.have.status(200);",
              "  const animals = pm.response.json();",
              "  pm.expect(animals).to.be.an('array').with.lengthOf.at.least(1);",
              "  const animal = animals[0];",
                  "  pm.expect(animal.internalTag).to.be.a('string').and.not.empty;",
                  "  pm.expect(animal.species).to.be.a('string').and.not.empty;",
                  "  pm.expect(animal.farm).to.be.a('string').and.not.empty;",
                  "  pm.expect(animal.birthDate).to.be.a('string');",
                  "  pm.expect(animal.currentWeightKg).to.be.a('number');",
                  "  pm.expect(animal.updatedAt).to.be.a('string');",
                  "  pm.expect(animal.photoCount).to.be.a('number');",
                  "  pm.expect(animal).to.have.property('coverPhotoUrl');",
                  "  pm.expect(animal).to.not.have.property('ageMonths');",
                  "  pm.collectionVariables.set('animalId', animal.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/api/animals"
      }
    },
    {
      "name": "Get animal detail",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Authorized user reads one animal', function () {",
              "  pm.response.to.have.status(200);",
              "  const animal = pm.response.json();",
              "  pm.expect(animal.id).to.eql(pm.collectionVariables.get('animalId'));",
                  "  pm.expect(animal.farm).to.be.a('string').and.not.empty;",
                  "  pm.expect(animal.sex).to.be.oneOf(['Male', 'Female']);",
                  "  pm.expect(animal.birthDate).to.be.a('string');",
                  "  pm.expect(animal.currentWeightKg).to.be.a('number');",
                  "});"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "method": "GET",
            "url": "{{baseUrl}}/api/animals/{{animalId}}"
          }
        },
        {
          "name": "List animals not updated recently",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Stale endpoint returns an array', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const stale = pm.response.json();",
                  "  pm.expect(stale).to.be.an('array');",
                  "  if (stale.length > 0) {",
                  "    pm.expect(stale[0].updatedAt).to.be.a('string');",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "GET",
            "url": "{{baseUrl}}/api/animals/stale?days=30"
          }
        },
        {
          "name": "Upload animal photo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authorized user uploads an animal photo', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.url).to.include('/uploads/');",
                  "  pm.expect(body.uploadedAt).to.be.a('string');",
                  "  pm.collectionVariables.set('photoUrl', body.url);",
                  "  pm.collectionVariables.set('photoId', body.photoId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "src/Presentation.API/wwwroot/favicon.png" }
              ]
            },
            "url": "{{baseUrl}}/api/animals/{{animalId}}/photo"
          }
        },
        {
          "name": "Get uploaded animal photo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Uploaded photo is served as a static file', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}{{photoUrl}}"
          }
        },
        {
          "name": "Delete animal photo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Authorized user deletes the animal photo', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "method": "DELETE",
            "url": "{{baseUrl}}/api/animals/{{animalId}}/photos/{{photoId}}"
          }
        },
        {
          "name": "Missing animal returns 404 Problem Details",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 uses RFC 7807', function () {",
              "  pm.response.to.have.status(404);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "  const problem = pm.response.json();",
              "  pm.expect(problem).to.include({ type: 'about:blank', title: 'Not Found', status: 404 });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
        "method": "GET",
        "url": "{{baseUrl}}/api/animals/00000000-0000-0000-0000-000000000000"
      }
    },
    {
      "name": "Unexpected exception returns safe 500 Problem Details",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('500 hides internal details and stack trace', function () {",
              "  pm.response.to.have.status(500);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "  const problem = pm.response.json();",
              "  pm.expect(problem).to.include({ type: 'about:blank', title: 'Internal Server Error', status: 500 });",
              "  pm.expect(problem.detail).to.eql('An unexpected error occurred.');",
              "  pm.expect(problem.instance).to.eql('/api/demo/errors/unexpected');",
              "  pm.expect(pm.response.text()).not.to.include('Simulated internal detail');",
              "  pm.expect(pm.response.text()).not.to.include('stackTrace');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/demo/errors/unexpected"
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:18080" },
    { "key": "adminUsername", "value": "admin" },
    { "key": "adminPassword", "value": "Admin123!Secure" },
    { "key": "accessToken", "value": "" },
    { "key": "newUserToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "photoUrl", "value": "" },
    { "key": "photoId", "value": "" },
    { "key": "runId", "value": "" },
    { "key": "animalId", "value": "" }
  ]
}
