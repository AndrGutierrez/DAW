            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/exchange-rates/usd-ves",
        "body": {
          "mode": "raw",
          "raw": "{\"submissionId\":\"{{$guid}}\",\"effectiveDate\":\"{{evaluationDate}}\",\"bolivarsPerDollar\":0}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('evaluationDate',new Date().toISOString().slice(0,10));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400',()=>pm.response.to.have.status(400));",
              "pm.test('RFC 7807 validation problem',()=>{pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');pm.expect(pm.response.json().errors).to.have.property('BolivarsPerDollar');});"
            ]
          }
        }
      ]
    },
    {
      "name": "Canal en vivo rechaza acceso anónimo",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/analytics/changes",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401',()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
