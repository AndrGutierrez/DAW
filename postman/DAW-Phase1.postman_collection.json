{
  "info": {
    "name": "DAW Phase 1 - IT Asset Inventory",
    "description": "Run in order against the Development environment. The collection verifies the domain endpoints and RFC 7807 error responses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create category",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runId', String(Date.now()));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Category created', function () {",
              "  pm.response.to.have.status(201);",
              "  const category = pm.response.json();",
              "  pm.expect(category.id).to.be.a('string');",
              "  pm.expect(category.name).to.eql('Computers ' + pm.collectionVariables.get('runId'));",
              "  pm.collectionVariables.set('categoryId', category.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Computers {{runId}}\",\"description\":\"Office equipment\"}"
        },
        "url": "{{baseUrl}}/api/categories"
      }
    },
    {
      "name": "Register asset",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Asset created and linked to category', function () {",
              "  pm.response.to.have.status(201);",
              "  const asset = pm.response.json();",
              "  pm.expect(asset.assetTag).to.eql('IT-' + pm.collectionVariables.get('runId'));",
              "  pm.expect(asset.categoryId).to.eql(pm.collectionVariables.get('categoryId'));",
              "  pm.expect(asset.status).to.eql(0);",
              "  pm.collectionVariables.set('assetId', asset.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"assetTag\":\"IT-{{runId}}\",\"name\":\"Laptop\",\"categoryId\":\"{{categoryId}}\",\"serialNumber\":\"SN-001\"}"
        },
        "url": "{{baseUrl}}/api/assets"
      }
    },
    {
      "name": "Get registered asset",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Registered asset is available', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('assetId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/assets/{{assetId}}"
      }
    },
    {
      "name": "Missing asset returns 404 Problem Details",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('404 uses RFC 7807', function () {",
              "  pm.response.to.have.status(404);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "  const problem = pm.response.json();",
              "  pm.expect(problem).to.include({ type: 'about:blank', title: 'Not Found', status: 404 });",
              "  pm.expect(problem.instance).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/assets/00000000-0000-0000-0000-000000000000"
      }
    },
    {
      "name": "Duplicate asset returns 400 Problem Details",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 uses RFC 7807', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "  const problem = pm.response.json();",
              "  pm.expect(problem.status).to.eql(400);",
              "  pm.expect(problem.title).to.eql('Bad Request');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"assetTag\":\"it-{{runId}}\",\"name\":\"Duplicate laptop\",\"categoryId\":\"{{categoryId}}\"}"
        },
        "url": "{{baseUrl}}/api/assets"
      }
    },
    {
      "name": "Unexpected exception returns safe 500 Problem Details",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('500 hides internal details and stack trace', function () {",
              "  pm.response.to.have.status(500);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "  const problem = pm.response.json();",
              "  pm.expect(problem).to.include({ type: 'about:blank', title: 'Internal Server Error', status: 500 });",
              "  pm.expect(problem.detail).to.eql('An unexpected error occurred.');",
              "  pm.expect(pm.response.text()).not.to.include('Simulated internal detail');",
              "  pm.expect(pm.response.text()).not.to.include('stackTrace');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/demo/errors/unexpected"
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:18080" },
    { "key": "runId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "assetId", "value": "" }
  ]
}
