# Copia este archivo a .env y define valores reales.
# .env NO se versiona (está en .gitignore y .dockerignore).
#
#   cp .env.example .env
#
# Genera un secreto JWT con:  openssl rand -base64 48

# PostgreSQL (consumido por docker-compose)
POSTGRES_DB=daw
POSTGRES_USER=daw
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_PORT=5432

# Firma JWT (mínimo 32 caracteres)
JWT_KEY=change-me-to-a-strong-random-secret-at-least-32-chars

# Usuario administrador del seed
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@daw.local
SEED_ADMIN_PASSWORD=change-me-admin-password

# Usuario Employee de demostración (opcional; contraseña con mayúscula, número y símbolo).
SEED_EMPLOYEE_USERNAME=employee
SEED_EMPLOYEE_EMAIL=employee@daw.local
SEED_EMPLOYEE_PASSWORD=

# Expanded opt-in demo: --seed-demo (all seven roles). Choose a private test password.
SEED_DEMO_PASSWORD=

# Aplicación y nginx
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_FORWARDEDHEADERS_ENABLED=false
# Optional exact IP of the trusted reverse proxy. Leave empty to record the transport peer.
TRUSTED_PROXY_IP=
DISABLE_HTTPS_REDIRECTION=true
NGINX_HTTP_PORT=18080
UPSTREAM=blazorapp:8080

# Fetch and retain BCV references from BCV Today every 30 minutes.
BCV_AUTO_SYNC=true
