# Copia este archivo a .env y define valores reales.
# .env NO se versiona (está en .gitignore y .dockerignore).
#
#   cp .env.example .env
#
# Genera un secreto JWT con:  openssl rand -base64 48

# PostgreSQL (consumido por docker-compose)
POSTGRES_DB=daw
POSTGRES_USER=daw
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_PORT=5432

# Firma JWT (mínimo 32 caracteres)
JWT_KEY=change-me-to-a-strong-random-secret-at-least-32-chars

# Usuario administrador del seed
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@daw.local
SEED_ADMIN_PASSWORD=change-me-admin-password

# Aplicación y nginx
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
DISABLE_HTTPS_REDIRECTION=true
NGINX_HTTP_PORT=18080
UPSTREAM=blazorapp:8080
