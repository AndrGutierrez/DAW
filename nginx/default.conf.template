# Resolve upstreams at request time via Docker's embedded DNS so nginx
# starts even if the app container/network is not reachable yet.
resolver 127.0.0.11 valid=10s ipv6=off;

# Viewer protocol as seen by CloudFront; falls back to X-Forwarded-Proto,
# then to the local connection scheme (docker compose local development).
map $http_x_forwarded_proto $proto_fallback {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

map $http_cloudfront_forwarded_proto $forwarded_proto {
    default $http_cloudfront_forwarded_proto;
    ''      $proto_fallback;
}

# Real viewer address: CloudFront-Viewer-Address is "IP:port" or "[IPv6]:port".
# Falls back to X-Forwarded-For, then to the direct peer.
map $http_cloudfront_viewer_address $viewer_raw {
    default $http_cloudfront_viewer_address;
    ''      $http_x_forwarded_for;
}

map $viewer_raw $viewer_ip {
    default $viewer_raw;
    ''      $remote_addr;
    ~^(?<viewer>\[[^\]]+\]|[^:]+):\d+$ $viewer;
}

map $http_x_forwarded_for $forwarded_for {
    default $http_x_forwarded_for;
    ''      $remote_addr;
}

map $http_x_forwarded_host $forwarded_host {
    default $http_x_forwarded_host;
    ''      $host;
}

# Blazor Server uses SignalR over WebSockets.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    set $upstream "${UPSTREAM}";
    root /usr/share/nginx/html;
    client_max_body_size 6m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;

    location /assets/ {
        try_files $uri =404;
    }

    location / {
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        try_files $uri $uri/ /index.html;
        expires -1;
    }


    # Offline database diagram viewer, served from the versioned ./db/diagram directory.
    location = /erd {
        return 301 /erd/;
    }

    location /erd/ {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /erd/index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location ~ ^/(api|swagger)(/|$) {
        proxy_pass http://$upstream;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $viewer_ip;
        proxy_set_header X-Forwarded-For   $forwarded_for;
        proxy_set_header X-Forwarded-Host  $forwarded_host;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;

        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 100s;
        proxy_buffering    off;
    }
}
